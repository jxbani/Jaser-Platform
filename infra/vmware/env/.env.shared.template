# =============================================================================
# Shared variables consumed by govc/* and scripts/*. Copy to .env.shared and
# fill in. Never commit the populated file.
# =============================================================================

# ---- vCenter / govc -------------------------------------------------------
GOVC_URL="vcenter.jaser.local"
GOVC_USERNAME="administrator@vsphere.local"
GOVC_PASSWORD=""                          # use a service account, not admin
GOVC_INSECURE="false"                     # set true only with a self-signed CA
GOVC_DATACENTER="DC-JASER"
GOVC_CLUSTER="CLUSTER-JASER"
GOVC_RESOURCE_POOL="RP-Jaser-Prod"
GOVC_FOLDER="Jaser/Prod"
GOVC_DATASTORE="DS-SSD-01"

# ---- Network portgroups ---------------------------------------------------
PG_DMZ="PG-Jaser-DMZ"
PG_APP="PG-Jaser-App"
PG_DATA="PG-Jaser-Data"
PG_MGMT="PG-Jaser-Mgmt"

# ---- VM templates (versioned, see topology.md) ----------------------------
TMPL_WEB="tmpl-jaser-web-v1"
TMPL_APP="tmpl-jaser-app-v1"
TMPL_DB="tmpl-jaser-db-v1"

# ---- Tier sizing ----------------------------------------------------------
WEB_VCPU=2   WEB_MEM_MB=4096    WEB_DISK_GB=40
APP_VCPU=4   APP_MEM_MB=8192    APP_DISK_GB=80
DB_VCPU=8    DB_MEM_MB=16384    DB_DISK_GB=200

# ---- Hostnames & addressing -----------------------------------------------
WEB_HOSTS="jaser-web-01 jaser-web-02"
APP_HOSTS="jaser-app-01 jaser-app-02"
DB_HOSTS="jaser-db-01"
DB_STANDBY_HOSTS="jaser-db-02"

NET_DOMAIN="jaser.local"
NET_DNS="10.10.99.2 10.10.99.3"
NET_NTP="ntp1.jaser.local ntp2.jaser.local"
WEB_VIP="10.10.10.250"

# ---- SSH ------------------------------------------------------------------
SSH_USER="jaser-ops"
SSH_KEY="$HOME/.ssh/jaser_ops_ed25519"     # private key, used by deploy.sh
BASTION_HOST="jaser-bastion-01.jaser.local"

# ---- Release layout (on app VMs) ------------------------------------------
APP_RELEASE_ROOT="/opt/jaser/releases"
APP_CURRENT="/opt/jaser/current"
APP_SHARED="/opt/jaser/shared"             # env files, logs, uploads
APP_USER="jaser"
APP_GROUP="jaser"
APP_SERVICE="jaser-app.service"
