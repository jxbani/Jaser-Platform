# =============================================================================
# Rendered onto jaser-web-* as /etc/jaser/web.env (mode 0640, owner nginx).
# Consumed by nginx via envsubst at first-boot.
# =============================================================================

SERVER_NAME="app.jaser.local"
TLS_CERT="/etc/letsencrypt/live/app.jaser.local/fullchain.pem"
TLS_KEY="/etc/letsencrypt/live/app.jaser.local/privkey.pem"

# Upstream Node.js servers (App tier). One entry per active VM.
APP_UPSTREAMS="10.10.20.10:3000 10.10.20.11:3000"

# keepalived for the floating VIP between web-01 / web-02
KEEPALIVED_VRID="42"
KEEPALIVED_VIP="10.10.10.250"
KEEPALIVED_AUTH_PASS="__KEEPALIVED_AUTH_PASS__"
KEEPALIVED_PRIORITY="100"          # 100 on web-01, 90 on web-02

# Rate-limit zones (req/s)
RATE_LIMIT_API="20"
RATE_LIMIT_AUTH="5"
