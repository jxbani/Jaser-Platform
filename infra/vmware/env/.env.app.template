# =============================================================================
# Rendered onto each app VM as /opt/jaser/shared/.env.app (mode 0640, owner
# jaser:jaser). Loaded by jaser-app.service via EnvironmentFile=.
# =============================================================================

NODE_ENV="production"
PORT="3000"
HOSTNAME="0.0.0.0"
NODE_OPTIONS="--enable-source-maps"

# Next.js
NEXT_TELEMETRY_DISABLED="1"

# Database — resolves on VLAN 30 only. Use the DNS name so primary failover
# is a DNS / keepalived event, not a redeploy.
DATABASE_URL="postgresql://jaser_app:__DB_APP_PASSWORD__@jaser-db-01.jaser.local:5432/jaser_platform?schema=public&sslmode=require"

# Auth.js
AUTH_SECRET="__AUTH_SECRET__"
AUTH_URL="https://app.jaser.local"
AUTH_TRUST_HOST="true"            # required when nginx terminates TLS

# Signup rules (see lib/validation/auth.ts)
ACADEMIC_EMAIL_SUFFIXES=".edu,.edu.jo,.ac.jo,.edu.sa,.ac.uk"
COMMERCIAL_REGISTRATION_REGEX="^[A-Z0-9-]{5,20}$"

# Observability
LOG_LEVEL="info"
OTEL_EXPORTER_OTLP_ENDPOINT="http://otel-collector.jaser.local:4318"
