# =============================================================================
# Rendered onto jaser-db-* as /etc/jaser/db.env (mode 0600, owner root). Used
# by postgres/init-db.sh and the WAL-archive cron.
# =============================================================================

PG_VERSION="16"
PG_DATA="/var/lib/pgsql/16/data"
PG_PORT="5432"
PG_LISTEN_ADDRESSES="10.10.30.10"
PG_REPLICATION_USER="replica"
PG_REPLICATION_PASSWORD="__PG_REPLICATION_PASSWORD__"

# Application roles
DB_NAME="jaser_platform"
DB_OWNER="jaser_owner"
DB_OWNER_PASSWORD="__DB_OWNER_PASSWORD__"
DB_APP_USER="jaser_app"
DB_APP_PASSWORD="__DB_APP_PASSWORD__"
DB_READONLY_USER="jaser_ro"
DB_READONLY_PASSWORD="__DB_READONLY_PASSWORD__"

# WAL archive — written to an NFS mount provisioned in vSphere (DS-NL-SAS-02)
WAL_ARCHIVE_DIR="/srv/pg-wal-archive"
WAL_RETENTION_DAYS="14"

# Backup
BACKUP_DIR="/srv/pg-backup"
BACKUP_RETENTION_DAYS="30"
