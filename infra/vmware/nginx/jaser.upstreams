# Regenerated by scripts/scale-out.sh whenever an app VM is added/removed.
# Initial population is rendered from .env.web::APP_UPSTREAMS by first-boot.
upstream jaser_app {
    least_conn;
    # one `server` line per app VM, e.g.
    # server 10.10.20.10:3000 max_fails=3 fail_timeout=10s;
    # server 10.10.20.11:3000 max_fails=3 fail_timeout=10s;
    keepalive 32;
}
