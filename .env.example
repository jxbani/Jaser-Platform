# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://jaser:jaser@localhost:5432/jaser_platform?schema=public"

# Optional: a privileged shadow database used by `prisma migrate dev`.
SHADOW_DATABASE_URL="postgresql://jaser:jaser@localhost:5432/jaser_platform_shadow?schema=public"

# Used by RLS-aware request handlers to set the current user / role on a
# per-transaction basis (SET LOCAL app.current_user_id = '...').
APP_JWT_SECRET="change-me-in-production"
