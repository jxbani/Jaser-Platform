# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://jaser:jaser@localhost:5432/jaser_platform?schema=public"

# Optional: a privileged shadow database used by `prisma migrate dev`.
SHADOW_DATABASE_URL="postgresql://jaser:jaser@localhost:5432/jaser_platform_shadow?schema=public"

# Used by RLS-aware request handlers to set the current user / role on a
# per-transaction basis (SET LOCAL app.current_user_id = '...').
APP_JWT_SECRET="change-me-in-production"

# ---- NextAuth.js (Auth.js v5) ----
# 32+ random bytes. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
# Base URL of the deployed app. Required when running behind a proxy.
AUTH_URL="http://localhost:3000"

# ---- Signup rules ----
# Comma-separated list of accepted academic email suffixes for STUDENT and
# PROFESSOR signups. Suffixes are matched case-insensitively from the end.
ACADEMIC_EMAIL_SUFFIXES=".edu,.edu.jo,.ac.jo,.edu.sa,.ac.uk"
# Regex (without delimiters) that a commercial registration number must
# match for COMPANY_REP signups.
COMMERCIAL_REGISTRATION_REGEX="^[A-Z0-9-]{5,20}$"
